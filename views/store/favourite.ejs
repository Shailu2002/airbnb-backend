 <%- include('../partials/head') %>
  </head>
  <body>
     <%- include('../partials/header') %>
    <main class="container" >
      <h1 class="text-2xl sm:text-4xl text-center font-extrabold "> Favourite List</h1>
      <div class="flex mt-4 flex-wrap gap-2.5 justify-evenly">
          <% registeredHome.forEach(home=> {%>
              <div class="w-75 shadow-2xl rounded-lg border-b h-75"> <img src="https://www.liveawilderlife.com/wp-content/uploads/2020/10/airbnb-asheville-treehouse.jpg" />
             <div><%=home.houseName%></div>
             <div><%=home.location%></div>
             <div class="flex flex-row justify-around">
              <div class="text-red-900 font-bold"><%=home.price%>/night</div>
             <div>⭐<%=home.ratings%></div>
             </div>
              <button class="rounded-md cursor-pointer bg-green-500 px-2 ml-2">Book</button>
              <button class="rounded-md cursor-pointer  float-end font-bold text-2xl px-2 ml-2">x</button>
             </div>
          <% }) %>
      </div> 
    </main>
  </body>
</html>
