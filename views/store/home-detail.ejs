 <%- include('../partials/head') %>
  </head>
  <body>
     <%- include('../partials/header') %>
    <main class="container mt-[4vh] text-center" >
      <h1 class="text-2xl   text-red-500 sm:text-5xl text-center font-extrabold "> Home Details page </h1>
      <p class="text-slate-600 mt-2">Details of </p>
      <div class=" flex justify-center ">
          <% home_detail.forEach(home=> {%>
              <div class="sm:w-[70%] lg:w-[55%] w-[80%] mt-5 flex  shadow-2xl rounded-lg border-b h-75">
                   <img class="h-75 w-[60%]" src="<%=home.photo %>" />
               <div class="ml-4 justify-items-start flex flex-col">
              <div class="mb-1"><%=home.houseName%></div>
             <div class="mb-1">
             <p class="text-slate-700 font-bold "> Description</p>
            </div>
              <div class="mb-1">
             <p class="text-slate-700 font-bold "> Location</p>
              <%=home.location%> 
            </div>
              <div class="text-red-900 mb-1 font-bold">
                 <p class="text-green-700 font-bold "> Price</p>
                <%=home.price%>/night</div>
             <div class="mb-1">
                 <p class="text-slate-700 font-bold "> Ratings</p>
              ⭐<%=home.ratings%>/5</div>
             <%- include('../partials/favourites',{home:home}) %>
             </div>
            </div>  
          <% }) %>
      </div> 
    </main>
  </body>
</html>
